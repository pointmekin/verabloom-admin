# Neon production or preview database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Separate Neon branch or PostgreSQL database used only by automated tests.
DATABASE_URL_TEST=postgresql://user:password@host/test_database?sslmode=require

# Shared admin credentials. Configure real values in the deployment environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password

# Random value with at least 32 characters. Generate this independently per environment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Product image storage. Use a public-read S3 bucket or a CDN base URL.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=verabloom-images
S3_PUBLIC_URL=https://verabloom-images.s3.ap-southeast-1.amazonaws.com
